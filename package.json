{
  "name": "savovpro-website",
  "private": true,
  "scripts": {
    "test": "playwright test --project=desktop --project=mobile",
    "test:headed": "playwright test --headed --project=desktop --project=mobile",
    "test:ui": "playwright test --ui",
    "test:configurator": "playwright test tests/e2e",
    "test:production": "PLAYWRIGHT_NO_WEBSERVER=1 playwright test tests/e2e/production.spec.js --project=production",
    "test:report": "playwright show-report",
    "build:vendor-potrace": "esbuild node_modules/@cadit-app/potrace-ts/dist/index.js --bundle --format=iife --global-name=PotraceTS --outfile=assets/js/vendor/potrace-ts.js",
    "build:vendor-vtracer": "cp node_modules/vtracer-webapp/vtracer_webapp_bg.wasm assets/js/vendor/vtracer_webapp_bg.wasm && esbuild node_modules/vtracer-webapp/vtracer_webapp_bg.js --bundle --format=iife --global-name=VTracerBg --outfile=assets/js/vendor/vtracer-webapp-bg.js",
    "build:fonts": "bash scripts/build-configurator-fonts.sh"
  },
  "devDependencies": {
    "@cadit-app/potrace-ts": "^1.3.0",
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/dancing-script": "^5.2.8",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/montserrat": "^5.2.8",
    "@fontsource/playfair-display": "^5.2.8",
    "@playwright/test": "^1.49.1",
    "vtracer-webapp": "^0.4.0"
  }
}
